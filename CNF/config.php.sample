<?php
// CNF/config.php - システム全体設定ファイル

// 1. システムの基本URL設定（環境に合わせて変更してください）
define('BASE_URL', 'https://sample.com/WebLantern/');

// config.php（/CNF）の1つ上の階層を基底ディレクトリとして自動取得
define('BASE_DIR', dirname(__DIR__));

// 基底ディレクトリを軸に各フォルダ・ファイルの絶対パスを定義
define('CNF_DIR',  BASE_DIR . '/CNF');
define('DB_DIR',   BASE_DIR . '/DB');
define('HTML_DIR', BASE_DIR . '/HTML');

// データベースパスの設定（起点ディレクトリ/DB/WebLantern.db）
define('DB_PATH',  DB_DIR . '/WebLantern.db');

// メール送信用設定
define('MAIL_FROM_EMAIL', 'noreply@sample.com');
define('MAIL_FROM_NAME', 'システム管理者');
define('MAIL_ADMIN_EMAIL', 'admin@example.com');

